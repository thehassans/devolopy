# ==========================================
# Devolopy Production Environment Variables
# ==========================================

# The canonical production URL of your website (used for SEO, metadata, sitemap.xml, robots.txt, and OpenGraph images)
# Replace with your actual domain connected to Hostinger (with https://)
NEXT_PUBLIC_SITE_URL=https://devolopy.com

# Server Environment
NODE_ENV=production

# Server Port (Hostinger's Node.js application or default Next.js port)
PORT=3000
